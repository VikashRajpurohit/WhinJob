# Edge Function environment. Secrets live here and ONLY here — never in app.json,
# expo-constants, or any .env bundled into the client (spec §6.4, §8).
#
# Local: copy to supabase/functions/.env (gitignored) for `supabase functions serve`.
# Remote: set with `supabase secrets set --env-file supabase/functions/.env`.

ANTHROPIC_API_KEY=
APIFY_TOKEN=

# Model IDs are read at call time so a downgrade is a config change, not an app
# release (spec §6.6). Do not hard-code these strings anywhere in the codebase.
CLAUDE_PARSE_MODEL=claude-opus-5
CLAUDE_BULK_MODEL=claude-opus-5
CLAUDE_DEEP_MODEL=claude-opus-5
CLAUDE_FALLBACK_MODEL=claude-haiku-4-5

# Cost ceilings, enforced server-side (spec §7.3, §6.6).
MAX_SEARCHES_PER_USER_PER_DAY=5
MONTHLY_SPEND_CEILING_USD=

# Apify actor ids (spec §7.1).
APIFY_ACTOR_LINKEDIN=valig/linkedin-jobs-scraper
APIFY_ACTOR_INDEED=valig/indeed-jobs-scraper
APIFY_ACTOR_NAUKRI=blackfalcondata/naukri-jobs-feed
